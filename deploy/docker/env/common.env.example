DEBUG=false

# Generate once with: openssl rand -hex 32
# This exact value is shared by all three containers.
CLASSROOM_SESSION_SECRET=replace-with-one-64-character-hex-secret
CLASSROOM_SESSION_COOKIE_NAME=guidelab_classroom_session
CLASSROOM_SESSION_HEADER=X-GuideLab-Session
CLASSROOM_SESSION_TTL_SECONDS=28800
CLASSROOM_SESSION_COOKIE_SECURE=true
CLASSROOM_SESSION_COOKIE_SAMESITE=lax

ACCESS_CONTROL_ENABLED=true
ACCESS_ADMIN_EMAIL=wangcheng308@bupt.edu.cn
ACCESS_COOKIE_NAME=guidelab_access
ACCESS_TOKEN_TTL_SECONDS=28800
ACCESS_TRUSTED_NETWORKS=[]

CORS_ORIGINS=["https://ruixi.tech","https://www.ruixi.tech"]
