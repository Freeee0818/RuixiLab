# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-noto-cjk \
        libgomp1 \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv

WORKDIR /app
COPY ai_module/requirements.txt ai_module/requirements.txt
COPY rag_module/requirements.txt rag_module/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r ai_module/requirements.txt

RUN groupadd --gid 10001 guidelab \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin guidelab \
    && mkdir -p /var/lib/guidelab-ai/logs \
    && chown -R 10001:10001 /var/lib/guidelab-ai

COPY --chown=10001:10001 config config
COPY --chown=10001:10001 service_common service_common
COPY --chown=10001:10001 ai_module ai_module
COPY --chown=10001:10001 rag_module rag_module
COPY --chown=10001:10001 scripts/ingest_knowledge.py scripts/ingest_knowledge.py
COPY --chown=10001:10001 scripts/test_rag.py scripts/test_rag.py
COPY --chown=10001:10001 scripts/evaluate_rag.py scripts/evaluate_rag.py

USER 10001:10001
EXPOSE 8001
CMD ["python", "-m", "ai_module.main", "--host", "0.0.0.0", "--port", "8001"]
