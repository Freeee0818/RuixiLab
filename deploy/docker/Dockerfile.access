# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/venv/bin:$PATH

RUN python -m venv /opt/venv

WORKDIR /app
COPY access_service/requirements.txt access_service/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && pip install -r access_service/requirements.txt

RUN groupadd --gid 10001 guidelab \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin guidelab \
    && mkdir -p /var/lib/guidelab-access/logs \
    && chown -R 10001:10001 /var/lib/guidelab-access

COPY --chown=10001:10001 config config
COPY --chown=10001:10001 service_common service_common
COPY --chown=10001:10001 access_service access_service

USER 10001:10001
EXPOSE 8002
CMD ["python", "-m", "access_service.main", "--host", "0.0.0.0", "--port", "8002"]
