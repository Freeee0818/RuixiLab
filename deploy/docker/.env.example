COMPOSE_PROJECT_NAME=ruixi-lab

# Host persistence directories. They are bind-mounted into non-root containers.
GUIDELAB_COMPUTE_DATA=/var/lib/guidelab-compute
GUIDELAB_AI_DATA=/var/lib/guidelab-ai
GUIDELAB_ACCESS_DATA=/var/lib/guidelab-access

# Pinned runtime/image names for repeatable rollback.
JULIA_VERSION=1.11.9
GUIDELAB_COMPUTE_IMAGE=ruixi-lab-compute:2026-08-10
GUIDELAB_AI_IMAGE=ruixi-lab-ai:2026-08-10
GUIDELAB_ACCESS_IMAGE=ruixi-lab-access:2026-08-10
