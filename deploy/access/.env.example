# Account and access-control API
DEBUG=false
ACCESS_SERVICE_HOST=127.0.0.1
ACCESS_SERVICE_PORT=8002

# Must be identical in access, AI, and compute services.
CLASSROOM_SESSION_SECRET=
CLASSROOM_SESSION_COOKIE_SECURE=true
CLASSROOM_SESSION_COOKIE_SAMESITE=lax

ACCESS_CONTROL_ENABLED=true
ACCESS_ADMIN_EMAIL=wangcheng308@bupt.edu.cn
ACCESS_COOKIE_NAME=guidelab_access
ACCESS_TOKEN_TTL_SECONDS=28800
ACCESS_TRUSTED_NETWORKS=[]
ACCESS_DB_PATH=/var/lib/guidelab-access/access.sqlite3

# Only for the first startup. Remove the plaintext password after login works.
ACCESS_BOOTSTRAP_ADMIN_USERNAME=teacher-admin
ACCESS_BOOTSTRAP_ADMIN_PASSWORD=
ACCESS_BOOTSTRAP_ADMIN_DISPLAY_NAME=教学管理员
ACCESS_BOOTSTRAP_ADMIN_EMAIL=wangcheng308@bupt.edu.cn
ACCESS_LOGIN_MAX_ATTEMPTS=8
ACCESS_LOGIN_WINDOW_SECONDS=300

LOG_DIR=/var/log/guidelab-access
LOG_FILE=/var/log/guidelab-access/access.log
CORS_ORIGINS=["https://ruixi.tech","https://www.ruixi.tech"]
CORS_ALLOW_CREDENTIALS=true
